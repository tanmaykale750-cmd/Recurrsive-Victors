# Copy to backend/.env and adjust.

# PostgreSQL connection (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg://casecompass:casecompass@localhost:5432/casecompass

# Long random string used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Groq API (https://console.groq.com/keys). Leave empty to run fully rule-based.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- OCR (PaddleOCR) --------------------------------------------------------
# Dates read by OCR below this confidence (0-100) are quarantined, never guessed
OCR_MIN_CONFIDENCE=85
# Models are downloaded once on first use (about 40 MB) and cached in ~/.paddlex
# (or PADDLE_PDX_CACHE_HOME). PP-OCRv6_medium_* is more accurate and about 2.5x slower on CPU.
OCR_DET_MODEL=PP-OCRv6_small_det
OCR_REC_MODEL=PP-OCRv6_small_rec
# Offline server: point these at downloaded model folders (each has inference.yml + weights)
OCR_DET_MODEL_DIR=
OCR_REC_MODEL_DIR=
OCR_ORIENTATION_MODEL_DIR=
# Turn sideways or upside-down scans upright first
OCR_FIX_ROTATION=true
# cpu | gpu | gpu:0  (empty = automatic)
OCR_DEVICE=
OCR_CPU_THREADS=0
# Download source tried first: huggingface | bos | modelscope | aistudio (empty = huggingface)
OCR_MODEL_SOURCE=
# Load the models in the background at startup so the first scan is not slow
OCR_PRELOAD=true

# Frontend origins allowed to call the API in development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
